export PATH="/bin:/sbin:/usr/bin:/usr/sbin"

## Custom prompt thats so beautiful OMG
PS1='\[\e[38;5;226m\]\w\[\e[0m\] \[\e[38;5;39m\]%\[\e[0m\] '

# Some vars
export EDITOR='/usr/bin/nano'

# Run scripts on /etc/profile.d if any
for i in /etc/profile.d/*.sh ; do
        if [ -r "$i" ]; then
                . $i
        fi
done
unset i

